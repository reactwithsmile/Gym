ConnectionStrings__DefaultConnection=Server=tcp:your-sql-server.database.windows.net,1433;Initial Catalog=GymDb;Persist Security Info=False;User ID=your-user;Password=replace-me;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
Jwt__Key=replace-with-a-random-secret-at-least-32-characters
Jwt__Issuer=GymApi
Jwt__Audience=GymApps
Jwt__ExpiresInMinutes=60
Cors__Origins__0=https://your-admin.vercel.app
Cors__Origins__1=https://your-frontend.vercel.app
Database__AutoMigrate=false
Seed__Enabled=false
# Only required for a deliberate, one-time seed operation:
# Seed__AdminEmail=admin@example.com
# Seed__AdminPassword=replace-with-a-strong-password
# Seed__TrainerEmail=trainer@example.com
# Seed__TrainerPassword=replace-with-a-strong-password
